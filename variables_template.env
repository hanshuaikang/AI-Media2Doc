MODEL_ID=xxx
LLM_API_KEY=xxx
STORAGE_ACCESS_KEY=xxx
STORAGE_SECRET_KEY=xxx
STORAGE_ENDPOINT=xxx
STORAGE_REGION=xxx
STORAGE_BUCKET=xxx
# ASR 实现切换。
# v1 和 v3 对应用层行为相同：提交音频 URL，轮询返回转写分段。
# v1 是原有 AUC 实现：appid + token + cluster。
# v3 是新版大模型 ASR 实现：API Key。
ASR_API_VERSION=v1
# v1 凭据，仅 ASR_API_VERSION=v1 时使用。
AUC_APP_ID=xxx
AUC_ACCESS_TOKEN=xxx
AUC_CLUSTER_ID=XXX
# v3 凭据，仅 ASR_API_VERSION=v3 时使用。
ASR_API_KEY=
# v3 resource id，仅 ASR_API_VERSION=v3 时使用，必须和已开通能力一致。
# 标准版示例：volc.bigasr.auc, volc.seedasr.auc
# 极速版示例：volc.bigasr.auc_turbo
ASR_RESOURCE_ID=volc.bigasr.auc
# 如果不需要密码访问，请留空或者删除此行
WEB_ACCESS_PASSWORD=
# 默认使用字节火山方舟的大模型服务
LLM_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
